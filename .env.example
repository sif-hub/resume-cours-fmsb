ANTHROPIC_API_KEY=sk-ant-...
# Optionnel : code à donner aux étudiants pour limiter l'accès (et les coûts)
ACCESS_CODE=
# Optionnel : nombre de résumés par heure et par IP (défaut 20)
HOURLY_LIMIT=20
# Optionnel : modèle (défaut claude-sonnet-5-5 ; claude-haiku-5-5 = moins cher)
MODEL=claude-sonnet-5-5
